{
  "name": "dsh-prompt-enhancer",
  "version": "0.2.2",
  "description": "Chat-box prompt auto-enhancement for DeepSeek Harness (dsh): rewrites your rough input into a clear, self-contained prompt before it reaches the model. Works like the prompt enhancer in WorkBuddy.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "prompt-enhancement",
    "cordis",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saul-dsh/dsh-prompt-enhancer.git"
  },
  "homepage": "https://github.com/saul-dsh/dsh-prompt-enhancer#readme",
  "bugs": {
    "url": "https://github.com/saul-dsh/dsh-prompt-enhancer/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
